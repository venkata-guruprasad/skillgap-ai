# =============================================================================
# SkillGap AI – Git Ignore Rules
# Excludes secrets, credentials, local DBs, uploaded resumes, ML binaries, and builds
# =============================================================================

# Environment variables & secrets (keep *.env.example templates only)
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.crt
secrets.*

# Local databases
*.db
*.db-journal
*.sqlite
*.sqlite3

# Python & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/

# Node / Frontend / Vercel
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
.vercel/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Uploaded resumes, private data & downloaded/trained AI/ML model artifacts
data/uploads/
uploads/
.cache/
*.joblib
*.pkl
*.pt
*.pth
*.bin
*.onnx
*.safetensors
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/sample_resumes/*
!data/sample_resumes/.gitkeep
data/job_descriptions/*
!data/job_descriptions/.gitkeep
models/trained/*
!models/trained/.gitkeep
models/pretrained/*
!models/pretrained/.gitkeep

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
