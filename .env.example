# =============================================================================
# SkillGap AI – Environment Variables Example
# Copy this file to .env and replace placeholder values with your own settings.
# Never commit .env files with real credentials to version control.
# =============================================================================

# --- Application Settings ---
APP_NAME=SkillGap AI
APP_ENV=development
DEBUG=true
ENABLE_API_DOCS=true
API_V1_PREFIX=/api

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
UVICORN_WORKERS=1
# Production: set to your exact frontend domain(s), e.g. https://skillgap-ai.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- PostgreSQL Database ---
# Option A: Individual connection parameters (used by Docker Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_strong_db_password
POSTGRES_DB=skillgap_ai

# Option B: Full connection URL (Neon / Supabase / Render / Railway; overrides POSTGRES_* vars)
# Managed Postgres providers require TLS (?sslmode=require):
# DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/skillgap_ai?sslmode=require

# Local SQLite fallback (automatically disabled in production)
ENABLE_LOCAL_SQLITE_FALLBACK=true

# --- Security / JWT Authentication ---
# Production requires a random secret >= 32 chars (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Resume Upload Storage ---
UPLOAD_DIR=/data/uploads

# --- Optional LLM Integration for Personalized Roadmaps ---
# Leave LLM_PROVIDER=none and LLM_API_KEY empty to use the built-in deterministic engine.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=25

# --- Frontend Settings (Vite / Vercel) ---
# Production: set to your deployed backend URL, e.g. https://skillgap-ai-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=SkillGap AI
